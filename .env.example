# Application
APP_NAME=NestJS Starter
APP_HOST=localhost
APP_PORT=3000
NODE_ENV=local

# Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL=

# Logger
LOG_LEVEL=debug
LOG_PRETTY=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true